# Postgres (matches docker-compose.yml; port 5433 to avoid clashing with a local pg)
DATABASE_URL=postgres://modmail:modmail@localhost:5433/modmail
POSTGRES_USER=modmail
POSTGRES_PASSWORD=modmail
POSTGRES_DB=modmail

# ─── Discord application ────────────────────────────────────────────────────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# Public invite/support links shown in the dashboard
DISCORD_INVITE_URL=
SUPPORT_SERVER_URL=

# ─── Bot ────────────────────────────────────────────────────────────────────
# Internal HTTP API the dashboard calls for gateway actions.
# Loopback by default; set 0.0.0.0 only when the dashboard runs in another
# container, and never publish this port to the host.
INTERNAL_API_PORT=4000
INTERNAL_API_HOST=127.0.0.1
# Shared by the bot (serves the API) and the dashboard (calls it). >= 32 chars.
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# Where the dashboard is reachable (used in embeds / links from the bot)
DASHBOARD_URL=http://localhost:3000

# ─── Dashboard ──────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
BETTER_AUTH_URL=http://localhost:3000
# How the dashboard reaches the bot internal API (auth uses INTERNAL_API_SECRET above)
BOT_API_URL=http://localhost:4000
