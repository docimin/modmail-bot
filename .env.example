# ─── Shared ───────────────────────────────────────────────────────────────
NODE_ENV=development

# Postgres (matches docker-compose.yml; port 5433 to avoid clashing with a local pg)
DATABASE_URL=postgres://modmail:modmail@localhost:5433/modmail

# ─── Discord application ────────────────────────────────────────────────────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# Public invite/support links shown in the dashboard
DISCORD_INVITE_URL=
SUPPORT_SERVER_URL=

# ─── Bot ────────────────────────────────────────────────────────────────────
# Internal HTTP API the dashboard calls for gateway actions
INTERNAL_API_PORT=4000
INTERNAL_API_SECRET=change-me-to-a-long-random-string
# Where the dashboard is reachable (used in embeds / links from the bot)
DASHBOARD_URL=http://localhost:3000

# ─── Dashboard ──────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
# How the dashboard reaches the bot internal API
BOT_API_URL=http://localhost:4000
BOT_API_SECRET=change-me-to-a-long-random-string
