{
  "name": "modmail",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "db:generate": "bun run --filter @modmail/db generate",
    "db:migrate": "bun run --filter @modmail/db migrate",
    "db:push": "bun run --filter @modmail/db push",
    "db:studio": "bun run --filter @modmail/db studio",
    "bot:dev": "bun run --filter @modmail/bot dev",
    "bot:start": "bun run --filter @modmail/bot start",
    "bot:deploy": "bun run --filter @modmail/bot deploy",
    "dashboard:dev": "bun run --filter @modmail/dashboard dev",
    "dashboard:build": "bun run --filter @modmail/dashboard build",
    "build": "bun run --filter @modmail/dashboard build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "dev": "bun run --filter '*' dev",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write"
  },
  "dependencies": {
    "nitro": "^3.0.260610-beta"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "esbuild",
    "lightningcss"
  ]
}
